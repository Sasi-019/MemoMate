# Copy to .env for local development. On Render, set these as Environment Variables.

# Hugging Face token for the AI assistant (required for /assistant/chat)
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Groq key for voice transcription (required for /voice/transcribe)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# IMPORTANT in production: use a hosted Postgres database.
# Render's disk is wiped on deploy, so SQLite loses all data there.
# Example: postgresql://user:password@host:5432/memomate
DATABASE_URL=sqlite:///./memomate.db

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
# Optional extra origins, comma separated
EXTRA_CORS_ORIGINS=
